# Copy to .env for local dev. Production values go in the host's settings
# (Vercel dashboard) — keep a copy in .env.prod (untracked), never commit them.

# Database — local Docker Postgres in dev.
# Production (Neon): the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Auth — single-user password gate. Both are required: the server refuses to start without them.
AUTH_PASSWORD="your-password-here"
# Random, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
AUTH_SECRET="generate-a-random-secret-here"

# adapter-node only (Docker / laptop): the exact URL the browser uses, e.g. https://librarian.example.ts.net
# Without it the login form is rejected as cross-site. Not needed on Vercel.
# ORIGIN="http://localhost:3000"

# Node
NODE_ENV=development

# .env.prod only (read by scripts/backup.ps1 and the migration, not by the app):
# DIRECT_DATABASE_URL = Neon's direct (non-pooled) connection string, for pg_dump / pg_restore.
